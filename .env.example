# Copy to .env and fill in what you need. Never commit .env.
# `make demo` works with NO .env at all (mock AI, local mail catcher, CSV instead of Sheets).

# --- AI provider: change this ONE line to switch vendors -----------------------
# gemini | anthropic | openai | mock
AI_PROVIDER=gemini

# Google AI Studio key (free tier is enough): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Free tiers are tight: the app paces itself to this many AI calls per minute.
AI_REQUESTS_PER_MINUTE=10

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Below this confidence the AI hands the conversation to a human (0..1).
CONFIDENCE_THRESHOLD=0.65

# --- Web panel ------------------------------------------------------------------
ADMIN_PASSWORD=
# Any long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:8088
DEMO_MODE=false

# --- Telegram -------------------------------------------------------------------
# Token from @BotFather. The owner's chat id receives hand-off alerts and reports.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# Optional: set to use a webhook (POST /webhooks/telegram/<secret>) instead of polling.
TELEGRAM_WEBHOOK_SECRET=

# --- Email ----------------------------------------------------------------------
# none | imap | mailpit (demo)
EMAIL_INBOX=none
EMAIL_ADDRESS=service@example.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Google Sheets (optional; without it bookings go to var/leads.csv) -----------
GOOGLE_SHEETS_ID=
# Path to the service-account JSON key (keep it in ./secrets, which is git-ignored).
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Infrastructure (docker compose sets these itself) ----------------------------
DATABASE_URL=postgresql+asyncpg://operator:operator@localhost:5432/operator
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
LOG_JSON=true
